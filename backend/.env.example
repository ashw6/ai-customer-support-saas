# --- Core ---
# development | production
ENVIRONMENT=production

# PostgreSQL (local or Supabase). In production this must be set explicitly.
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Required - min 32 random characters in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_32_CHAR_SECRET
# JWT optional tuning
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins allowed to call the API (cookies / credentials).
# Local dev defaults apply if unset. In production, set your frontend URL(s), e.g.:
CORS_ORIGINS=https://your-app.vercel.app

# Public frontend URL (password reset links, etc.)
FRONTEND_URL=https://your-app.vercel.app

# Logging
LOG_LEVEL=INFO
# Reduce noise from health checks in access-style logs
SKIP_HEALTH_ACCESS_LOG=true

# --- AI chat / embeddings ---
# ollama | openai
# Production recommendation: openai, because RAG needs both chat and embeddings.
AI_PROVIDER=openai

# Production: Use hosted Ollama endpoint (not localhost)
# Replace with your hosted Ollama server URL
OLLAMA_GENERATE_URL=https://your-ollama-host.com/api/generate
# Optional override; defaults to same host as generate URL with /api/chat
OLLAMA_CHAT_URL=https://your-ollama-host.com/api/chat
OLLAMA_EMBEDDINGS_URL=https://your-ollama-host.com/api/embeddings
OLLAMA_CHAT_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_HISTORY_LIMIT=12
OLLAMA_NUM_PREDICT=120
RAG_MAX_CONTEXT_DISTANCE=0.60
# Use Ollama /api/chat (recommended). Set false to use legacy /api/generate.
OLLAMA_USE_CHAT_API=true
# Development helper: set true only if you want canned demo replies when Ollama fails.
AI_CHAT_FALLBACK_ENABLED=false
# Set true for portfolio demos when you want instant replies without running Ollama.
# When false in production, OLLAMA_* URLs must not point at localhost.
AI_CHAT_FALLBACK_ONLY=false

# Hosted OpenAI-compatible provider. Use this for production AI without hosting Ollama.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TIMEOUT_SECONDS=120
# OPENAI_MAX_TOKENS=180

# --- ChromaDB (local vector store) ---
CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION=support_documents

# --- Email (Resend preferred; Gmail SMTP fallback if RESEND_API_KEY is unset) ---
# Resend (production / custom domain) - RECOMMENDED
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="AI Support <onboarding@yourdomain.com>"
RESEND_EMAILS_URL=https://api.resend.com/emails
RESEND_TIMEOUT_SECONDS=15

# Gmail SMTP fallback (use an App Password: https://myaccount.google.com/apppasswords)
# Only used if RESEND_API_KEY is not set
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional display From header (defaults to "AI Support <SMTP_USER>")
# SMTP_FROM_EMAIL="AI Support <you@gmail.com>"
# SMTP_TIMEOUT_SECONDS=15

PASSWORD_RESET_EXPIRE_MINUTES=15
